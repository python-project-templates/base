import os
import os.path
{%- if add_c_abi %}

if os.name == "nt" and os.path.isdir(os.path.join(os.path.dirname(__file__), "lib")):
    # Windows has no rpath, so the extension finds lib{{ module }}.dll through this directory.
    _DLL_DIRECTORY = os.add_dll_directory(os.path.join(os.path.dirname(__file__), "lib"))
{%- endif %}

from .extension import *

__version__ = "0.1.0"


def include_path():
    return os.path.abspath(os.path.join(os.path.dirname(__file__), "include"))


def bin_path():
    return os.path.abspath(os.path.join(os.path.dirname(__file__), "bin"))


def lib_path():
    return os.path.abspath(os.path.join(os.path.dirname(__file__), "lib"))
{%- if add_c_abi %}


def get_prefix() -> str:
    """The installed package directory, which holds ``include`` and ``lib`` for lib{{ module }}."""
    return os.path.abspath(os.path.dirname(__file__))


def get_include() -> str:
    """The directory holding ``{{ module }}/{{ module }}.h``."""
    return include_path()


def get_library_dirs() -> list[str]:
    """Directories holding the bundled lib{{ module }} shared library."""
    return [lib_path()]


def get_libraries() -> list[str]:
    """Link names for lib{{ module }}, for ``-l`` or ``target_link_libraries``."""
    return ["lib{{ module }}" if os.name == "nt" else "{{ module }}"]
{%- endif %}
