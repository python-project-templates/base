[package]
name = "{{ module }}_py"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
name = "{{ module }}"
path = "rust/python/lib.rs"
crate-type = ["cdylib"]

[dependencies]
{{ module }} = { path = "./rust", version = "*"{% if add_c_abi %}, optional = true{% endif %} }
pyo3 = { version = "0.29.2", features = ["abi3", "extension-module", "multiple-pymethods"] }
{% if add_c_abi %}
[features]
default = ["direct"]
capi = []
direct = ["dep:{{ module }}"]
{% endif %}
[profile.release]
panic = 'abort'
lto = true
