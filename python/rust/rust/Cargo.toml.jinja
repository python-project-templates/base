[package]
name = "{{ module }}"
version = "0.1.0"
authors = ["{{ team }} <{{ email }}>"]
edition = "2021"
license = "Apache-2.0"
readme = "../README.md"
repository = "https://github.com/{{ github }}/{{ project_name }}"
description = "{{ project_description }}"

[lib]
name = "{{ module }}"
path = "src/lib.rs"
crate-type = ["rlib"]

[dependencies]
{%- if add_c_abi %}

[workspace]
members = [
    ".",
    "capi",
]
{%- endif %}
