language = "C"
cpp_compat = true
include_guard = "{{ module | upper }}_H"
include_version = false
autogen_warning = "/* Generated by cbindgen from rust/capi/src; edit the Rust source instead. */"
documentation = true
style = "both"
usize_is_size_t = true

[enum]
prefix_with_name = false

[parse]
parse_deps = false
