```

Import design tokens once at the application root:

```css
@import '{{ package_name }}/tokens.css';
```

```svelte
<script lang="ts">
  import { BrandMark, ThemeToggle } from '{{ package_name }}';
</script>

<BrandMark />
<ThemeToggle />
