import { LitElement, css, html } from 'lit';
import { customElement } from 'lit/decorators.js';

@customElement('{{ element_prefix }}-brand-mark')
export class BrandMark extends LitElement {
  static styles = css`
    a {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      color: inherit;
      font-weight: 700;
      text-decoration: none;
    }

    span {
      display: grid;
      width: 2rem;
      height: 2rem;
      place-items: center;
      border-radius: 50%;
      color: var(--{{ css_prefix }}-bg);
      background: var(--{{ css_prefix }}-fg);
      box-shadow: 3px 3px 0 var(--{{ css_prefix }}-focus);
    }
  `;

  render() {
    return html`<a href="/" aria-label="{{ brand_name }}, home"><span aria-hidden="true">{{ brand_name[0] | upper }}</span>{{ brand_name }}</a>`;
  }
}

declare global {
  interface HTMLElementTagNameMap {
    '{{ element_prefix }}-brand-mark': BrandMark;
  }
}
